<%- include('partials/head', { title: 'Error - IT Helpdesk' }) %>

    <body class="min-h-screen">
        <div class="flex flex-col md:flex-row min-h-screen">
            <!-- Left Side - Image & Branding (same as login) -->
            <div class="flex-1 relative bg-cover bg-center flex flex-col justify-center items-center p-8 md:p-12"
                style="background-image: url('/images/gedung.jpg');">
                <div class="absolute inset-0 bg-black/50"></div>
                <div class="relative z-10 text-center text-white flex flex-col items-center">
                    <img src="/images/lps.png" alt="LPS Logo"
                        class="w-20 md:w-36 h-auto mb-4 md:mb-8 brightness-0 invert">
                    <h1 class="text-2xl md:text-4xl font-bold mb-2 md:mb-4 drop-shadow-lg">Helpdesk Ticketing System
                    </h1>
                    <p class="text-sm md:text-lg opacity-95 max-w-md leading-relaxed drop-shadow">Sistem layanan
                        pengaduan
                        dan bantuan teknis Lembaga Penjamin Simpanan</p>
                </div>
            </div>

            <!-- Right Side - Error Content -->
            <div class="flex-1 bg-white flex items-center justify-center p-6 md:p-12">
                <div class="w-full max-w-md text-center">
                    <!-- Error Icon with Exclamation Mark -->
                    <div class="mb-6">
                        <div
                            class="w-28 h-28 mx-auto bg-gradient-to-br from-red-500 to-red-600 rounded-full flex items-center justify-center shadow-xl">
                            <span class="text-white text-6xl font-bold">!</span>
                        </div>
                    </div>

                    <!-- Error Code -->
                    <p class="text-5xl font-bold text-lps-blue mb-2">
                        <%= error.status || 500 %>
                    </p>

                    <!-- Error Title -->
                    <h2 class="text-2xl md:text-3xl font-semibold text-lps-blue mb-4">
                        <% if (error.status===403) { %>
                            Akses Ditolak
                            <% } else if (error.status===404) { %>
                                Halaman Tidak Ditemukan
                                <% } else { %>
                                    Terjadi Kesalahan
                                    <% } %>
                    </h2>

                    <!-- Description -->
                    <p class="text-gray-500 mb-8 leading-relaxed">
                        <% if (error.status===403) { %>
                            Anda tidak memiliki izin untuk mengakses halaman ini.<br>
                            Silakan logout dan login dengan akun yang sesuai.
                            <% } else if (error.status===404) { %>
                                Halaman yang Anda cari tidak ditemukan.<br>
                                Mungkin halaman telah dipindahkan atau dihapus.
                                <% } else { %>
                                    Terjadi kesalahan pada sistem.<br>
                                    Silakan coba beberapa saat lagi.
                                    <% } %>
                    </p>

                    <!-- Action Buttons -->
                    <div class="flex flex-col gap-4">
                        <a href="/auth/logout"
                            class="w-full bg-gradient-to-r from-lps-orange to-lps-orange-light text-white py-3 rounded-lg font-semibold flex items-center justify-center gap-2 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-lps-orange/40 transition-all">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            LOGOUT
                        </a>
                        <button onclick="history.back()"
                            class="w-full bg-gray-100 text-lps-blue py-3 rounded-lg font-semibold flex items-center justify-center gap-2 hover:bg-gray-200 hover:-translate-y-0.5 transition-all">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M19 12H5M12 19l-7-7 7-7"></path>
                            </svg>
                            KEMBALI
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </body>

    </html>