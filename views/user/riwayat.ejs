<%- include('../partials/head', { title: 'Riwayat Pengaduan' }) %>

    <body class="bg-gray-100 min-h-screen">
        <%- include('../partials/header', { userRole: 'user' , activePage: 'riwayat' ,
            headerTitle: 'Helpdesk Ticketing System - User' }) %>

            <!-- Main Container -->
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <!-- My Tickets Section -->
                <div class="bg-white rounded-xl shadow-lg p-8">
                    <div class="border-b border-gray-200 pb-4 mb-6">
                        <h2 class="text-xl font-bold text-gray-900">Riwayat Pengaduan Saya</h2>
                        <p class="text-gray-500 text-sm mt-1">Lihat status pengaduan yang telah Anda ajukan</p>
                    </div>

                    <!-- Tickets Table -->
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-gray-200">
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        No Tiket</th>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Tanggal</th>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Subject</th>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Category</th>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Status</th>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Technician</th>
                                </tr>
                            </thead>
                            <tbody id="ticketsTableBody" class="divide-y divide-gray-100">
                            </tbody>
                        </table>
                    </div>

                    <!-- Empty State -->
                    <div id="emptyState" class="hidden text-center py-12 text-gray-500">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1" class="mx-auto mb-4 text-gray-300">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                        <h3 class="text-lg font-semibold text-gray-700">Belum ada tiket</h3>
                        <p>Anda belum mengajukan pengaduan</p>
                    </div>
                </div>
            </div>

            <script>
                async function loadMyTickets() {
                    const tbody = document.getElementById('ticketsTableBody');
                    const emptyState = document.getElementById('emptyState');

                    try {
                        const response = await fetch('/user/tickets');
                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            emptyState.classList.remove('hidden');
                            tbody.innerHTML = '';
                            return;
                        }

                        const tickets = data.tickets || [];
                        renderTickets(tickets);
                    } catch (error) {
                        console.error('Load tickets error:', error);
                        emptyState.classList.remove('hidden');
                        tbody.innerHTML = '';
                    }
                }

                function renderTickets(tickets) {
                    const tbody = document.getElementById('ticketsTableBody');
                    const emptyState = document.getElementById('emptyState');

                    if (tickets.length === 0) {
                        emptyState.classList.remove('hidden');
                        return;
                    }

                    emptyState.classList.add('hidden');

                    tbody.innerHTML = tickets.map(ticket => {
                        const statusStyles = {
                            'Open': 'bg-blue-100 text-blue-700 border border-blue-200',
                            'Closed': 'bg-green-100 text-green-700 border border-green-200',
                            'On Hold': 'bg-orange-100 text-orange-600 border border-orange-200',
                            'Cancelled': 'bg-red-100 text-red-700 border border-red-200'
                        };
                        const statusStyle = statusStyles[ticket.requestStatus] || statusStyles['Open'];

                        const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                        const formattedDate = `${monthNames[ticket.bulan - 1]} ${ticket.tahun}`;

                        return `
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-4 py-4 text-sm font-bold text-gray-900">${ticket.noTiket}</td>
                    <td class="px-4 py-4 text-sm text-gray-600">${formattedDate}</td>
                    <td class="px-4 py-4 text-sm text-gray-600">${ticket.subject || '-'}</td>
                    <td class="px-4 py-4 text-sm text-gray-600">${ticket.category || '-'}</td>
                    <td class="px-4 py-4"><span class="px-3 py-1 rounded-full text-xs font-bold uppercase ${statusStyle}">${ticket.requestStatus}</span></td>
                    <td class="px-4 py-4 text-sm text-gray-600">${ticket.technician || '<span class="text-gray-400 italic">Belum ditugaskan</span>'}</td>
                </tr>`;
                    }).join('');
                }

                window.addEventListener('load', loadMyTickets);
            </script>
    </body>

    </html>