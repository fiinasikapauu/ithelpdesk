<%- include('../partials/head', { title: 'Riwayat Pengaduan' }) %>

    <body class="bg-gray-100 min-h-screen">
        <%- include('../partials/header', { userRole: 'user' , activePage: 'riwayat' ,
            headerTitle: 'Helpdesk Ticketing System - User' }) %>

            <!-- Main Container -->
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <!-- My Tickets Section -->
                <div class="bg-white rounded-xl shadow-lg p-8">
                    <div class="border-b border-gray-200 pb-4 mb-6">
                        <h2 class="text-xl font-bold text-gray-900">Riwayat Pengaduan Saya</h2>
                        <p class="text-gray-500 text-sm mt-1">Lihat status pengaduan yang telah Anda ajukan</p>
                    </div>

                    <!-- Tickets Table (Desktop) -->
                    <div class="hidden lg:block overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b-2 border-gray-100">
                                    <th
                                        class="text-left py-4 px-3 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Tanggal</th>
                                    <th
                                        class="text-left py-4 px-3 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Subject</th>
                                    <th
                                        class="text-left py-4 px-3 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Category</th>
                                    <th
                                        class="text-left py-4 px-3 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Status</th>
                                    <th
                                        class="text-left py-4 px-3 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Technician</th>
                                    <th
                                        class="text-left py-4 px-3 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                        Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="ticketsTableBody" class="divide-y divide-gray-100">
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile/Tablet Cards -->
                    <div id="mobileCards" class="lg:hidden space-y-4">
                    </div>

                    <!-- Empty State -->
                    <div id="emptyState" class="hidden text-center py-12 text-gray-500">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1" class="mx-auto mb-4 text-gray-300">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                        <h3 class="text-lg font-semibold text-gray-700">Belum ada tiket</h3>
                        <p>Anda belum mengajukan pengaduan</p>
                    </div>
                </div>
            </div>

            <!-- Detail Modal -->
            <div id="detailModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
                <div class="bg-white rounded-2xl shadow-2xl max-w-xl w-full max-h-[90vh] overflow-y-auto">
                    <div class="p-4 sm:p-6 border-b border-gray-100 flex items-center justify-between">
                        <h3 class="text-lg sm:text-xl font-bold text-lps-blue">Detail Tiket</h3>
                        <button onclick="closeModal()"
                            class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>
                    </div>
                    <div id="detailContent" class="p-4 sm:p-6">
                        <p class="text-gray-500">Loading...</p>
                    </div>
                    <div class="p-4 sm:p-6 border-t border-gray-100">
                        <button onclick="closeModal()"
                            class="w-full py-3 border-2 border-gray-200 rounded-lg text-gray-600 font-semibold hover:bg-gray-50 transition-all">
                            Tutup
                        </button>
                    </div>
                </div>
            </div>

            <script>
                async function loadMyTickets() {
                    const tbody = document.getElementById('ticketsTableBody');
                    const mobileCards = document.getElementById('mobileCards');
                    const emptyState = document.getElementById('emptyState');

                    try {
                        const response = await fetch('/user/tickets');
                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            emptyState.classList.remove('hidden');
                            tbody.innerHTML = '';
                            mobileCards.innerHTML = '';
                            return;
                        }

                        const tickets = data.tickets || [];
                        renderTickets(tickets);
                    } catch (error) {
                        console.error('Load tickets error:', error);
                        emptyState.classList.remove('hidden');
                        tbody.innerHTML = '';
                        mobileCards.innerHTML = '';
                    }
                }

                function renderTickets(tickets) {
                    const tbody = document.getElementById('ticketsTableBody');
                    const mobileCards = document.getElementById('mobileCards');
                    const emptyState = document.getElementById('emptyState');

                    if (tickets.length === 0) {
                        emptyState.classList.remove('hidden');
                        return;
                    }

                    emptyState.classList.add('hidden');

                    const statusStyles = {
                        'Open': 'bg-green-100 text-green-700',
                        'Closed': 'bg-blue-100 text-blue-700',
                        'On Hold': 'bg-yellow-100 text-yellow-700',
                        'Cancelled': 'bg-red-100 text-red-700'
                    };

                    const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];

                    // Desktop Table
                    tbody.innerHTML = tickets.map(ticket => {
                        const statusStyle = statusStyles[ticket.requestStatus] || 'bg-gray-100 text-gray-600';
                        const formattedDate = `${ticket.tanggal} ${monthNames[ticket.bulan - 1]} ${ticket.tahun}`;

                        return `
                        <tr class="hover:bg-gray-50 transition-colors">

                            <td class="py-4 px-3 text-sm text-gray-600">${formattedDate}</td>
                            <td class="py-4 px-3 text-sm text-gray-600 max-w-[150px] truncate" title="${ticket.subject || '-'}">${ticket.subject || '-'}</td>
                            <td class="py-4 px-3 text-sm text-gray-600">${ticket.category || '-'}</td>
                            <td class="py-4 px-3">
                                <span class="px-2 py-1 rounded-full text-xs font-bold uppercase ${statusStyle}">${ticket.requestStatus}</span>
                            </td>
                            <td class="py-4 px-3 text-sm text-gray-600">${ticket.technician || '-'}</td>
                            <td class="py-4 px-3">
                                <button onclick="showDetail('${ticket.noTiket}')" 
                                    class="text-gray-400 hover:text-lps-blue transition-colors p-1" title="Lihat Detail">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                            </td>
                        </tr>`;
                    }).join('');

                    // Mobile Cards
                    mobileCards.innerHTML = tickets.map(ticket => {
                        const statusStyle = statusStyles[ticket.requestStatus] || 'bg-gray-100 text-gray-600';
                        const formattedDate = `${ticket.tanggal} ${monthNames[ticket.bulan - 1]} ${ticket.tahun}`;

                        return `
                        <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
                            <div class="flex items-start justify-between mb-3">
                                <div>
                                    <p class="text-sm font-bold text-gray-800">Tiket #${ticket.noTiket}</p>
                                    <p class="text-xs text-gray-500">${formattedDate}</p>
                                </div>
                                <span class="px-2 py-1 rounded-full text-xs font-bold uppercase ${statusStyle}">${ticket.requestStatus}</span>
                            </div>
                            <p class="text-sm text-gray-700 font-medium mb-2 line-clamp-2">${ticket.subject || '-'}</p>
                            <div class="grid grid-cols-2 gap-2 text-xs text-gray-500 mb-3">
                                <div><span class="font-medium">Category:</span> ${ticket.category || '-'}</div>
                                <div><span class="font-medium">Technician:</span> ${ticket.technician || '-'}</div>
                            </div>
                            <button onclick="showDetail('${ticket.noTiket}')" 
                                class="w-full py-2 text-sm text-lps-blue border border-lps-blue rounded-lg hover:bg-blue-50 transition-colors">
                                Lihat Detail
                            </button>
                        </div>`;
                    }).join('');
                }

                async function showDetail(ticketId) {
                    document.getElementById('detailModal').classList.remove('hidden');
                    document.getElementById('detailModal').classList.add('flex');
                    document.getElementById('detailContent').innerHTML = '<p class="text-gray-500 text-center py-8">Loading...</p>';

                    try {
                        const response = await fetch(`/user/tickets/${ticketId}`);
                        const data = await response.json();

                        if (data.success) {
                            const t = data.ticket;
                            let statusColor = 'bg-gray-100 text-gray-600';
                            const statusName = t.status?.status_name || 'Unknown';
                            if (statusName.toLowerCase() === 'open') statusColor = 'bg-green-100 text-green-700';
                            else if (statusName.toLowerCase() === 'closed') statusColor = 'bg-blue-100 text-blue-700';
                            else if (statusName.toLowerCase() === 'on hold') statusColor = 'bg-yellow-100 text-yellow-700';
                            else if (statusName.toLowerCase() === 'cancelled') statusColor = 'bg-red-100 text-red-700';

                            const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                            const formattedDate = `${t.tanggal || '-'}/${t.bulan}/${t.tahun}`;

                            document.getElementById('detailContent').innerHTML = `
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                                <div>
                                    <p class="text-sm font-bold text-lps-blue mb-1">Nomor Tiket:</p>
                                    <p class="text-gray-700">${t.ticket_id}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-lps-blue mb-1">Tanggal Dibuat:</p>
                                    <p class="text-gray-700">${formattedDate}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-lps-orange mb-1">Requester:</p>
                                    <p class="text-gray-700">${t.requester_name}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-lps-orange mb-1">Unit Kerja:</p>
                                    <p class="text-gray-700">${t.unit?.unit_name || '-'}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-lps-orange mb-1">Request Type:</p>
                                    <p class="text-gray-700">${t.request_type?.request_type_name || '-'}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-lps-orange mb-1">Category:</p>
                                    <p class="text-gray-700">${t.category?.category_name || '-'}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-lps-orange mb-1">Subcategory:</p>
                                    <p class="text-gray-700">${t.subcategory?.subcategory_name || '-'}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-lps-orange mb-1">Status:</p>
                                    <span class="px-2 py-1 rounded-full text-xs font-bold uppercase ${statusColor}">${statusName}</span>
                                </div>
                            </div>
                            <div class="mb-4">
                                <p class="text-sm font-bold text-lps-orange mb-1">Subject:</p>
                                <p class="text-gray-700">${t.subject}</p>
                            </div>
                            <div class="mb-4">
                                <p class="text-sm font-bold text-lps-orange mb-1">Technician:</p>
                                <p class="text-gray-700">${t.technician?.technician_name || 'Belum ditugaskan'}</p>
                            </div>
                            <div class="border-t border-gray-200 pt-6 mt-6">
                                <p class="text-sm font-bold text-gray-600 mb-4">Log Aktivitas</p>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <p class="text-xs font-medium text-gray-500 mb-1">Log Status (Terakhir Update):</p>
                                        <p class="text-sm text-gray-700">${t.log_status ? new Date(t.log_status).toLocaleString('id-ID', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-'}</p>
                                    </div>
                                    <div>
                                        <p class="text-xs font-medium text-gray-500 mb-1">Log Technician (Terakhir Update):</p>
                                        <p class="text-sm text-gray-700">${t.log_technician ? new Date(t.log_technician).toLocaleString('id-ID', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-'}</p>
                                    </div>
                                </div>
                            </div>
                        `;
                        } else {
                            document.getElementById('detailContent').innerHTML = '<p class="text-red-500 text-center py-8">Gagal memuat detail tiket</p>';
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        document.getElementById('detailContent').innerHTML = '<p class="text-red-500 text-center py-8">Gagal memuat detail tiket</p>';
                    }
                }

                function closeModal() {
                    document.getElementById('detailModal').classList.add('hidden');
                    document.getElementById('detailModal').classList.remove('flex');
                }

                // Close modal when clicking outside
                document.getElementById('detailModal').addEventListener('click', function (e) {
                    if (e.target === this) closeModal();
                });

                window.addEventListener('load', loadMyTickets);
            </script>
    </body>

    </html>