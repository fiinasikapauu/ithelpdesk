<%- include('../partials/head', { title: 'Form Pengaduan' }) %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <style>
        .custom-dropdown-overrides {
            max-height: 20rem !important;
        }

        .dropdown-animation {
            transition: all 0.2s ease-in-out;
        }

        .form-select-bg {
            background-color: white;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%23555%22%20d%3D%22M6%209L1%204h10z%22%2F%3E%3C%2Fsvg%3E");
            background-repeat: no-repeat;
            background-position: right 1rem center;
        }
    </style>

    <body class="bg-gray-100 min-h-screen">
        <%- include('../partials/header', { userRole: 'user' , activePage: 'form' ,
            headerTitle: 'Helpdesk Ticketing System - User' }) %>

            <!-- Main Container -->
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <!-- Success Alert -->
                <div id="successAlert"
                    class="hidden bg-green-600 text-white p-4 rounded-lg mb-6 flex items-center gap-3">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span>Tiket pengaduan berhasil dikirim! Nomor tiket Anda akan segera diproses.</span>
                </div>

                <!-- Form Card -->
                <div class="bg-white rounded-xl shadow-lg p-8">
                    <div class="border-b border-gray-200 pb-4 mb-6">
                        <h2 class="text-xl font-bold text-gray-900">Form Pengaduan Helpdesk</h2>
                        <p class="text-gray-500 text-sm mt-1">Silakan isi formulir di bawah ini untuk mengajukan
                            pengaduan atau permintaan bantuan teknis</p>
                    </div>

                    <form id="ticketForm">
                        <!-- Personal Information Section -->
                        <h3 class="text-base font-bold text-lps-blue mb-4 border-b-2 border-lps-blue pb-1 inline-block">
                            Informasi Pelapor</h3>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4 mb-8">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Requester (Nama Pelapor)
                                    <span class="text-red-500">*</span></label>
                                <input type="text"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-lps-blue transition-all"
                                    id="requester" required placeholder="Masukkan nama lengkap Anda">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Unit Kerja <span
                                        class="text-red-500">*</span></label>
                                <!-- Custom Dropdown Unit Kerja -->
                                <div class="relative w-full" id="unitFilterContainer">
                                    <input type="hidden" id="unitKerja" required>
                                    <input type="text" id="unitSearchInput" placeholder="-- Pilih Unit Kerja --"
                                        autocomplete="off"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-lps-blue transition-all cursor-pointer form-select-bg">

                                    <div id="unitDropdown"
                                        class="hidden absolute z-50 w-full custom-dropdown-overrides mt-2 bg-white border border-gray-100 rounded-xl shadow-2xl overflow-y-auto ring-1 ring-black/5 divide-y divide-gray-50 transform origin-top left-0 dropdown-animation">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ticket Information Section -->
                        <h3 class="text-base font-bold text-lps-blue mb-4 border-b-2 border-lps-blue pb-1 inline-block">
                            Detail Pengaduan</h3>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Request Type <span
                                        class="text-red-500">*</span></label>
                                <!-- Custom Dropdown Request Type -->
                                <div class="relative w-full" id="requestTypeFilterContainer">
                                    <input type="hidden" id="requestType" required>
                                    <input type="text" id="requestTypeSearchInput"
                                        placeholder="-- Pilih Request Type --" autocomplete="off"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-lps-blue transition-all cursor-pointer form-select-bg">

                                    <div id="requestTypeDropdown"
                                        class="hidden absolute z-50 w-full custom-dropdown-overrides mt-2 bg-white border border-gray-100 rounded-xl shadow-2xl overflow-y-auto ring-1 ring-black/5 divide-y divide-gray-50 transform origin-top left-0 dropdown-animation">
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Category <span
                                        class="text-red-500">*</span></label>
                                <!-- Custom Dropdown Category -->
                                <div class="relative w-full" id="categoryFilterContainer">
                                    <input type="hidden" id="category" required>
                                    <input type="text" id="categorySearchInput" placeholder="-- Pilih Category --"
                                        autocomplete="off"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-lps-blue transition-all cursor-pointer form-select-bg">

                                    <div id="categoryDropdown"
                                        class="hidden absolute z-50 w-full custom-dropdown-overrides mt-2 bg-white border border-gray-100 rounded-xl shadow-2xl overflow-y-auto ring-1 ring-black/5 divide-y divide-gray-50 transform origin-top left-0 dropdown-animation">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Subcategory <span
                                    class="text-red-500">*</span></label>
                            <!-- Custom Dropdown Subcategory -->
                            <div class="relative w-full" id="subcategoryFilterContainer">
                                <input type="hidden" id="subcategory" required>
                                <input type="text" id="subcategorySearchInput" placeholder="-- Pilih Subcategory --"
                                    autocomplete="off"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-lps-blue transition-all cursor-pointer bg-white bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%23555%22%20d%3D%22M6%209L1%204h10z%22%2F%3E%3C%2Fsvg%3E')] bg-no-repeat bg-[right_1rem_center]">

                                <div id="subcategoryDropdown"
                                    class="hidden absolute z-50 w-full custom-dropdown-overrides mt-2 bg-white border border-gray-100 rounded-xl shadow-2xl overflow-y-auto ring-1 ring-black/5 divide-y divide-gray-50 transform origin-top left-0 dropdown-animation">
                                </div>
                            </div>
                        </div>

                        <div class="mt-6">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Subject <span
                                    class="text-red-500">*</span></label>
                            <input type="text"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-lps-blue transition-all"
                                id="subject" required placeholder="Ringkasan singkat masalah Anda">
                        </div>

                        <!-- Submit Buttons -->
                        <div class="flex justify-between items-center mt-8 pt-6 border-t border-gray-200">
                            <button type="button" onclick="resetForm()"
                                class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg font-semibold flex items-center gap-2 hover:bg-gray-50 transition-all">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                                    <path d="M21 3v5h-5"></path>
                                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                                    <path d="M3 21v-5h5"></path>
                                </svg>
                                Reset Form
                            </button>
                            <button type="submit"
                                class="px-8 py-3 bg-lps-orange text-white rounded-lg font-semibold flex items-center gap-2 hover:bg-lps-orange-light transition-all shadow-md">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M22 2L11 13"></path>
                                    <path d="M22 2L15 22L11 13L2 9L22 2Z"></path>
                                </svg>
                                Kirim Pengaduan
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <script id="units-data"
                type="application/json"><%- JSON.stringify(typeof units !== 'undefined' ? units : []) %></script>
            <script id="request-types-data"
                type="application/json"><%- JSON.stringify(typeof requestTypes !== 'undefined' ? requestTypes : []) %></script>
            <script id="categories-data"
                type="application/json"><%- JSON.stringify(typeof categories !== 'undefined' ? categories : []) %></script>
            <script id="subcategories-data"
                type="application/json"><%- JSON.stringify(typeof subcategories !== 'undefined' ? subcategories : []) %></script>

            <script>
                // Load Data
                const unitsData = JSON.parse(document.getElementById('units-data').textContent);
                const requestTypesData = JSON.parse(document.getElementById('request-types-data').textContent);
                const categoriesData = JSON.parse(document.getElementById('categories-data').textContent);
                const subcategoriesData = JSON.parse(document.getElementById('subcategories-data').textContent);

                // Prepare Data for Dropdowns
                const unitOptions = unitsData.map(u => ({ id: u.unit_name, name: u.unit_name }));
                const requestTypeOptions = requestTypesData.map(rt => ({ id: rt.request_type_name, name: rt.request_type_name }));
                const categoryOptions = categoriesData.map(c => ({ id: c.category_name, name: c.category_name }));

                // Subcategory Map
                const subcategoryMap = {};
                categoriesData.forEach(function (cat) {
                    const relatedSubs = subcategoriesData
                        .filter(function (sub) { return sub.category_id === cat.category_id; })
                        .map(function (sub) { return { id: sub.subcategory_name, name: sub.subcategory_name }; });

                    if (relatedSubs.length > 0) {
                        subcategoryMap[cat.category_name] = relatedSubs;
                    }
                });

                // Dropdown Setup Function
                function setupSearchableDropdown(config) {
                    const container = document.getElementById(config.containerId);
                    const input = document.getElementById(config.inputId);
                    const hiddenInput = document.getElementById(config.hiddenInputId);
                    const dropdown = document.getElementById(config.dropdownId);
                    const defaultText = config.defaultText || '-- Pilih --';
                    let optionsData = config.options || [];

                    // Render Options
                    function renderOptions(items) {
                        dropdown.innerHTML = '';
                        if (items.length === 0) {
                            dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500">Tidak ada data</div>';
                            return;
                        }

                        items.forEach(item => {
                            const div = document.createElement('div');
                            div.className = "px-4 py-3 hover:bg-orange-50 hover:text-lps-orange cursor-pointer text-sm text-gray-600 transition-colors duration-200 group flex items-center justify-between";
                            div.dataset.name = item.name.toLowerCase();
                            div.innerHTML = `
                                <span class="block truncate">${item.name}</span>
                            `;
                            div.onclick = () => selectItem(item.id, item.name);
                            dropdown.appendChild(div);
                        });
                    }

                    // Initial Render
                    renderOptions(optionsData);

                    // Select Logic
                    function selectItem(id, name) {
                        hiddenInput.value = id;
                        input.value = name || '';
                        dropdown.classList.add('hidden');

                        if (config.onSelect) {
                            config.onSelect(id, name);
                        }
                    }

                    // Toggle
                    input.addEventListener('click', () => {
                        // Close others
                        document.querySelectorAll('.dropdown-animation').forEach(el => {
                            if (el !== dropdown) el.classList.add('hidden');
                        });
                        dropdown.classList.toggle('hidden');
                    });

                    // Search
                    input.addEventListener('input', (e) => {
                        dropdown.classList.remove('hidden');
                        const val = e.target.value.toLowerCase();
                        const options = dropdown.querySelectorAll('div[data-name]');

                        let found = false;
                        options.forEach(opt => {
                            if (opt.dataset.name.includes(val)) {
                                opt.classList.remove('hidden');
                                found = true;
                            } else {
                                opt.classList.add('hidden');
                            }
                        });

                        if (!found && val !== '') {
                            // Optional: Show "Not Found" message if needed, or leave blank
                        }
                    });

                    // Input Focus/Blur
                    input.addEventListener('focus', function () {
                        // if (this.value === defaultText) this.value = ''; // Not using defaultText in value, placeholder does the job
                    });

                    // Outside click
                    document.addEventListener('click', (e) => {
                        if (!container.contains(e.target)) {
                            dropdown.classList.add('hidden');
                        }
                    });

                    // Return update function for dynamic options
                    return {
                        updateOptions: (newOptions) => {
                            optionsData = newOptions;
                            renderOptions(newOptions);
                            hiddenInput.value = '';
                            input.value = '';
                        }
                    };
                }

                // Initialize Dropdowns
                setupSearchableDropdown({
                    containerId: 'unitFilterContainer',
                    inputId: 'unitSearchInput',
                    hiddenInputId: 'unitKerja',
                    dropdownId: 'unitDropdown',
                    defaultText: '-- Pilih Unit Kerja --',
                    options: unitOptions
                });

                // Initialize Subcategory first (empty)
                const subcategoryDropdownCtrl = setupSearchableDropdown({
                    containerId: 'subcategoryFilterContainer',
                    inputId: 'subcategorySearchInput',
                    hiddenInputId: 'subcategory',
                    dropdownId: 'subcategoryDropdown',
                    defaultText: '-- Pilih Subcategory --',
                    options: []
                });

                // Initialize Category
                const categoryDropdownCtrl = setupSearchableDropdown({
                    containerId: 'categoryFilterContainer',
                    inputId: 'categorySearchInput',
                    hiddenInputId: 'category',
                    dropdownId: 'categoryDropdown',
                    defaultText: '-- Pilih Category --',
                    options: [],
                    onSelect: (categoryId, categoryName) => {
                        // Update Subcategories
                        const relatedSubs = subcategoryMap[categoryName] || [];
                        subcategoryDropdownCtrl.updateOptions(relatedSubs);
                    }
                });

                // Initialize Request Type
                // Category Map
                const categoryMap = {};
                requestTypesData.forEach(function (rt) {
                    const relatedCats = categoriesData
                        .filter(function (cat) { return cat.request_type_id === rt.request_type_id; })
                        .map(function (cat) { return { id: cat.category_name, name: cat.category_name }; });

                    if (relatedCats.length > 0) {
                        categoryMap[rt.request_type_name] = relatedCats;
                    }
                });

                // Initialize Request Type
                setupSearchableDropdown({
                    containerId: 'requestTypeFilterContainer',
                    inputId: 'requestTypeSearchInput',
                    hiddenInputId: 'requestType',
                    dropdownId: 'requestTypeDropdown',
                    defaultText: '-- Pilih Request Type --',
                    options: requestTypeOptions,
                    onSelect: (id, name) => {
                        // Update Categories based on Request Type
                        const relatedCats = categoryMap[name] || [];
                        categoryDropdownCtrl.updateOptions(relatedCats);

                        // Clear Category and Subcategory selections
                        document.getElementById('category').value = '';
                        document.getElementById('categorySearchInput').value = '';

                        document.getElementById('subcategory').value = '';
                        document.getElementById('subcategorySearchInput').value = '';
                        subcategoryDropdownCtrl.updateOptions([]);
                    }
                });

                document.getElementById('ticketForm').addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const submitBtn = this.querySelector('button[type="submit"]');
                    const originalBtnText = submitBtn.innerHTML;
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="flex items-center gap-2">Processing...</span>';
                    submitBtn.classList.add('opacity-50', 'cursor-not-allowed');

                    const payload = {
                        requester: document.getElementById('requester').value,
                        unitKerja: document.getElementById('unitKerja').value,
                        requestType: document.getElementById('requestType').value,
                        category: document.getElementById('category').value,
                        subcategory: document.getElementById('subcategory').value,
                        subject: document.getElementById('subject').value
                    };

                    try {
                        const response = await fetch('/user/tickets', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        });

                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Gagal',
                                text: data.message || 'Gagal mengirim tiket. Silakan coba lagi.'
                            });
                            return;
                        }

                        // Success
                        Swal.fire({
                            icon: 'success',
                            title: 'Berhasil!',
                            text: 'Tiket pengaduan berhasil dikirim.',
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            // Reset form without asking confirmation again since it's success flow
                            resetForm(true);
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        });

                        // Hide old alert if visible
                        document.getElementById('successAlert').classList.add('hidden');

                    } catch (error) {
                        console.error('Submit ticket error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Terjadi kesalahan sistem saat mengirim tiket.'
                        });
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnText;
                        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    }
                });

                function resetForm(force = false) {
                    const performReset = () => {
                        document.getElementById('ticketForm').reset();

                        // Clear Custom Dropdowns
                        ['unitKerja', 'requestType', 'category', 'subcategory'].forEach(id => {
                            const hiddenInput = document.getElementById(id);
                            const searchInput = document.getElementById(id.replace('Kerja', '') + 'SearchInput');
                            if (hiddenInput) hiddenInput.value = '';
                            if (searchInput) searchInput.value = '';
                            // Special case for unitKerja id mismatch in naming convention vs implementation
                            if (id === 'unitKerja') document.getElementById('unitSearchInput').value = '';
                        });

                        // Reset Subcategory options
                        subcategoryDropdownCtrl.updateOptions([]);

                        // Reset Category options
                        categoryDropdownCtrl.updateOptions([]);
                    };

                    if (force) {
                        performReset();
                    } else {
                        Swal.fire({
                            title: 'Reset Form?',
                            text: "Apakah Anda yakin ingin mengosongkan form?",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Ya, Reset',
                            cancelButtonText: 'Batal'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                performReset();
                                Swal.fire(
                                    'Reset!',
                                    'Form telah dikosongkan.',
                                    'success'
                                );
                            }
                        });
                    }
                }
            </script>
    </body>

    </html>